# Brain server environment for deploy/compose.yml (service `brain`). Copy to deploy/.env.
# Every BRAIN_* variable the server reads (src/config.ts) is listed; commented lines show the default.

# Public origin: exactly the URL people and agents use (the reverse proxy hostname). Must be https:// (no BRAIN_DEV).
BRAIN_ORIGIN=https://brain.example.com
# BRAIN_DEV must stay unset in production (it allows an http origin and verbose errors).
# BRAIN_DEV=

# Client IP behind the reverse proxy: the TCP peer is the proxy container, which puts the real client
# address last in X-Forwarded-For. 1 = trust one hop, so the server uses the last XFF entry.
# See deploy/README.md "Client IP and origin".
BRAIN_TRUSTED_PROXY=1

# Single tenant slug.
# BRAIN_TENANT=default
# Agent that gets the `admin` capability at start (e.g. my-assistant); empty = none.
# BRAIN_BOOTSTRAP_ADMIN_AGENT=

# Fixed by the image (deploy/Dockerfile); change only if you know why.
# BRAIN_HOST=0.0.0.0
# BRAIN_PORT=7460
# BRAIN_DATA_DIR=/data
# BRAIN_WEB_DIR=/app/web/dist

# Limits.
# BRAIN_MAX_DOC_KB=512
# BRAIN_MAX_FILE_MB=20
# BRAIN_MAX_REQUEST_MB=2
# BRAIN_MAX_IMPORT_MB=256
# BRAIN_MAX_DATA_BYTES=5368709120
# BRAIN_MIN_FREE_MB=64
# BRAIN_AUDIT_MAX_MB=512
# BRAIN_MAX_OPEN_PROPOSALS=50
# BRAIN_TOKEN_DAYS=90

# Rate limits per principal per minute (auth failures: per client IP).
# BRAIN_RATE_WRITE=30
# BRAIN_RATE_READ=300
# BRAIN_RATE_SEARCH=60
# BRAIN_RATE_READ_MB=32
# BRAIN_RATE_AUTH_FAIL=10
# BRAIN_RATE_POLL=6

# Inbox long-poll.
# BRAIN_INBOX_WAIT_MAX_S=50
# BRAIN_INBOX_WAITERS=32

# Background janitor and webhook delivery (0 = off).
# BRAIN_BACKGROUND=1
# Hosts allowed for http:// webhooks. Note: brain-net is internal, so outgoing webhooks cannot leave
# the host unless you attach brain to an egress network (see README).
# BRAIN_WEBHOOK_ALLOW_HOSTS=

# BRAIN_LOG_LEVEL=info
